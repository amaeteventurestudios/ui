{
  "rewrites": [
    {
      "source": "/ai-lab",
      "destination": "/ai-lab.html"
    },
    {
      "source": "/ai-lab-film",
      "destination": "/ai-lab-film.html"
    }
  ],
  "headers": [
    {
      "source": "/ai-lab-film(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
